\end{Highlighting}
\end{Shaded}

Verificar permisos:

\begin{Shaded}
\begin{Highlighting}[]
\FunctionTok{ls} \AttributeTok{{-}l}\NormalTok{ /datos\_empresa/clientes.txt}
\end{Highlighting}
\end{Shaded}

